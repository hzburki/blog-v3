---
import BlogCard from "../../components/blog-card.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import { getPosts, groupPostsByTag } from "../../lib";

export async function getStaticPaths() {
  // Drafts are left out in production, so draft-only tags get no page
  const posts = await getPosts();

  return [...groupPostsByTag(posts)].map(([tag, posts]) => ({
    params: { tag },
    props: { posts },
  }));
}

const tag = Astro.params.tag;
const posts = Astro.props.posts;
---

<Layout title={`${tag} - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <main>
    <h1 class="mb-5 text-xl font-medium">Tag: {tag}</h1>
    <ul class="flex flex-col gap-1.5">
      {posts.map((post) => (
        <li>
          <BlogCard post={post} />
        </li>
      ))}
    </ul>
  </main>
</Layout>
