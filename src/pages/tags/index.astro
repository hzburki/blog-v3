---
import TagBadge from "../../components/tag-badge.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import { countPostsByTag, getPosts } from "../../lib";

const sortedTags = countPostsByTag(await getPosts());
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  className="flex h-svh max-w-sm flex-col justify-center"
>
  <main>
    <div>
      <ul class="flex flex-wrap gap-2">
        {sortedTags.map(([tag, count]) => (
          <li>
            <TagBadge tag={tag} count={count} />
          </li>
        ))}
      </ul>
    </div>
  </main>
</Layout>
